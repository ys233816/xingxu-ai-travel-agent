# DeepSeek's OpenAI-compatible endpoint and current available chat model.
MODEL_BASE_URL=https://api.deepseek.com/v1
MODEL_API_KEY=
MODEL_NAME=deepseek-flash
MODEL_JSON_MODE=json_object
MODEL_TIMEOUT_MS=90000

# Optional generic token pricing for providers without cache-tier reporting.
MODEL_INPUT_PRICE_PER_MILLION=
MODEL_OUTPUT_PRICE_PER_MILLION=

# Optional tiered pricing for one million tokens. A complete tiered set takes
# precedence over the generic rates. Prices and the time window are versioned.
MODEL_INPUT_CACHE_HIT_OFF_PEAK_PRICE_PER_MILLION=
MODEL_INPUT_CACHE_HIT_PEAK_PRICE_PER_MILLION=
MODEL_INPUT_CACHE_MISS_OFF_PEAK_PRICE_PER_MILLION=
MODEL_INPUT_CACHE_MISS_PEAK_PRICE_PER_MILLION=
MODEL_OUTPUT_OFF_PEAK_PRICE_PER_MILLION=
MODEL_OUTPUT_PEAK_PRICE_PER_MILLION=
MODEL_PRICE_PERIOD=auto
MODEL_OFF_PEAK_START=
MODEL_OFF_PEAK_END=
MODEL_PRICE_TIMEZONE=Asia/Shanghai
MODEL_PRICE_CURRENCY=CNY
MODEL_PRICE_VERSION=
MODEL_PRICE_SOURCE=

# QWeather requires the API host assigned to your project.
QWEATHER_API_KEY=
QWEATHER_API_HOST=
QWEATHER_GEO_HOST=https://geoapi.qweather.com
QWEATHER_TIMEOUT_MS=12000

# AMap Web Service key.
AMAP_API_KEY=
AMAP_TIMEOUT_MS=12000
AMAP_ROUTE_SPACING_MS=450
AMAP_ROUTE_RETRY_DELAY_MS=1200

# RollingGo hotel MCP. Keep the key in .env.local only.
ROLLINGGO_MCP_URL=https://mcp.rollinggo.cn/mcp
ROLLINGGO_API_KEY=
ROLLINGGO_MCP_PROTOCOL_VERSION=2025-03-26
ROLLINGGO_TIMEOUT_MS=60000

# Explicit opt-in marker for paid Live Eval. Automated runs also require --confirm-costs.
ENABLE_LIVE_EVAL=false

PORT=4173
